NETWORK_NAME=fznetwork
CONTAINER_NAME=fzimmich
PORT_MAPPING=2283

# Redis configuration
IMMICH_CREATE_REDIS=no
REDIS_HOSTNAME=redis
REDIS_HOSTNAME_EXTERNAL=fzredis
REDIS_CONTAINER_NAME=fzredis

# The location where your uploaded files are stored
UPLOAD_LOCATION=./local/data

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=Asia/Calcutta

# The Immich version to use. You can pin this to a specific version like "v2.1.0"
IMMICH_VERSION=v3

# Database configuration
IMMICH_CREATE_DATABASE=no
# DB_HOSTNAME=database
DB_HOSTNAME_EXTERNAL=fzpostgres
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=./local/postgres-data
