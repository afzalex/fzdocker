# Base URL where tinyauth is reachable, override in .env for your domain
TINYAUTH_APPURL=https://auth.fzmacair.com

# Comma-separated list of username:bcrypt-hash entries, e.g. admin:$2a$10$...
# Generated automatically by ./init.sh, or manually with:
#   docker run -i -t --rm ghcr.io/tinyauthapp/tinyauth:v5 user create --interactive
TINYAUTH_AUTH_USERS=

# Recommended: set to the IP/CIDR of your reverse proxy (e.g. Traefik) so
# X-Real-IP / X-Forwarded-For headers are trusted. 172.17.0.0/16 works for
# the default Docker bridge network.
TINYAUTH_AUTH_TRUSTEDPROXIES=172.17.0.0/16

# TINYAUTH_OAUTH_PROVIDERS_GOOGLE_CLIENTID=
# TINYAUTH_OAUTH_PROVIDERS_GOOGLE_CLIENTSECRET=
# TINYAUTH_OAUTH_WHITELIST=your-email@gmail.com
# TINYAUTH_OAUTH_AUTOREDIRECT=google